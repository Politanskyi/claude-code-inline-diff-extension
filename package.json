{
  "name": "claude-inline-diff",
  "version": "0.1.22",
  "description": "Review Claude Code's edits inline, like Cursor's agent diff: red removed lines between your code, green added lines, Keep/Undo per change, file or all (Cmd+Y / Cmd+N), Claude Changes list under the chat, undo.",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "node scripts/build.js && node test/e2e/run.js",
    "package": "node scripts/build.js --production && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links -o claude-inline-diff.vsix",
    "vscode:uninstall": "node ./dist/uninstall.js"
  },
  "keywords": [
    "claude",
    "claude code",
    "inline diff",
    "cursor",
    "accept reject",
    "code review"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.9"
  },
  "displayName": "Claude Inline Diff",
  "publisher": "inlinediff",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "editorInsets",
    "contribEditorContentMenu"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "claudeInlineDiff.acceptHunk",
        "title": "Keep Change",
        "category": "Claude Inline Diff",
        "icon": "$(check)"
      },
      {
        "command": "claudeInlineDiff.rejectHunk",
        "title": "Undo Change",
        "category": "Claude Inline Diff",
        "icon": "$(discard)"
      },
      {
        "command": "claudeInlineDiff.rejectHunkWithFeedback",
        "title": "Undo Change with Feedback for Claude…",
        "category": "Claude Inline Diff",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeInlineDiff.acceptFile",
        "title": "Keep File (all changes in this file)",
        "category": "Claude Inline Diff",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "title": "Undo File (all changes in this file)",
        "category": "Claude Inline Diff",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeInlineDiff.acceptAll",
        "title": "Keep All (all files)",
        "category": "Claude Inline Diff",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeInlineDiff.rejectAll",
        "title": "Undo All (all files)",
        "category": "Claude Inline Diff",
        "icon": "$(close-all)"
      },
      {
        "command": "claudeInlineDiff.undo",
        "title": "Revert Last Keep/Undo",
        "category": "Claude Inline Diff",
        "icon": "$(reply)"
      },
      {
        "command": "claudeInlineDiff.keepFileText",
        "title": "Keep File",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.keepFileTextMac",
        "title": "Keep File ⌘⏎",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.keepFileTextCtrl",
        "title": "Keep File Ctrl+Enter",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.undoFileText",
        "title": "Undo File",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.nextFileText",
        "title": "Review Next File",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.keepAllChangesText",
        "title": "Keep all changes",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.reviewAll",
        "title": "Review All Changes (multi-file diff)",
        "category": "Claude Inline Diff",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "claudeInlineDiff.nextHunk",
        "title": "Next Change",
        "category": "Claude Inline Diff",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeInlineDiff.nextHunkInFile",
        "title": "Next Change in This File",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.prevHunkInFile",
        "title": "Previous Change in This File",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.prevHunk",
        "title": "Previous Change",
        "category": "Claude Inline Diff",
        "icon": "$(arrow-up)"
      },
      {
        "command": "claudeInlineDiff.nextFile",
        "title": "Next File with Changes",
        "category": "Claude Inline Diff",
        "icon": "$(arrow-right)"
      },
      {
        "command": "claudeInlineDiff.prevFile",
        "title": "Previous File with Changes",
        "category": "Claude Inline Diff",
        "icon": "$(arrow-left)"
      },
      {
        "command": "claudeInlineDiff.showDiff",
        "title": "Open Side-by-Side Diff",
        "category": "Claude Inline Diff",
        "icon": "$(diff)"
      },
      {
        "command": "claudeInlineDiff.listFiles",
        "title": "List Files to Review",
        "category": "Claude Inline Diff",
        "icon": "$(list-flat)"
      },
      {
        "command": "claudeInlineDiff.installHooks",
        "title": "Install Claude Code Hook",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.uninstallHooks",
        "title": "Uninstall Claude Code Hook",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.hookStatus",
        "title": "Show Hook Status",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.fixKeybindings",
        "title": "Fix Shortcut Conflicts with Other Extensions",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.placeChangesView",
        "title": "Show Claude Changes Under the Claude Code Chat",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.enableInsets",
        "title": "Enable Inline Removed-Code Blocks (argv.json)…",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.revertStep",
        "title": "Revert to Before This Step",
        "category": "Claude Inline Diff",
        "icon": "$(history)"
      },
      {
        "command": "claudeInlineDiff.clearSnapshots",
        "title": "Delete Review Snapshots (.claude-review)…",
        "category": "Claude Inline Diff"
      },
      {
        "command": "claudeInlineDiff.refresh",
        "title": "Refresh",
        "category": "Claude Inline Diff",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeInlineDiff.openFile",
        "title": "Open File at First Change",
        "category": "Claude Inline Diff"
      }
    ],
    "keybindings": [
      {
        "command": "claudeInlineDiff.acceptHunk",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "editorTextFocus && claudeInlineDiff.cursorInHunk && config.claudeInlineDiff.keybindingScheme != 'alt'"
      },
      {
        "command": "claudeInlineDiff.rejectHunk",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "editorTextFocus && claudeInlineDiff.cursorInHunk && config.claudeInlineDiff.keybindingScheme != 'alt'"
      },
      {
        "command": "claudeInlineDiff.acceptFile",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges && config.claudeInlineDiff.keybindingScheme != 'alt'"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges && config.claudeInlineDiff.keybindingScheme != 'alt'"
      },
      {
        "command": "claudeInlineDiff.acceptFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges && config.claudeInlineDiff.keybindingScheme != 'alt'"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges && config.claudeInlineDiff.keybindingScheme != 'alt'"
      },
      {
        "command": "claudeInlineDiff.acceptHunk",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && claudeInlineDiff.cursorInHunk && config.claudeInlineDiff.keybindingScheme != 'cursor'"
      },
      {
        "command": "claudeInlineDiff.rejectHunk",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "editorTextFocus && claudeInlineDiff.cursorInHunk && config.claudeInlineDiff.keybindingScheme != 'cursor'"
      },
      {
        "command": "claudeInlineDiff.acceptFile",
        "key": "ctrl+shift+alt+enter",
        "mac": "cmd+shift+alt+enter",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges && config.claudeInlineDiff.keybindingScheme != 'cursor'"
      },
      {
        "command": "claudeInlineDiff.rejectFile",
        "key": "ctrl+shift+alt+backspace",
        "mac": "cmd+shift+alt+backspace",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges && config.claudeInlineDiff.keybindingScheme != 'cursor'"
      },
      {
        "command": "claudeInlineDiff.nextHunk",
        "key": "alt+f5",
        "mac": "alt+f5",
        "when": "editorTextFocus && claudeInlineDiff.hasChanges"
      },
      {
        "command": "claudeInlineDiff.prevHunk",
        "key": "shift+alt+f5",
        "mac": "shift+alt+f5",
        "when": "editorTextFocus && claudeInlineDiff.hasChanges"
      },
      {
        "command": "claudeInlineDiff.nextHunkInFile",
        "key": "alt+j",
        "mac": "alt+j",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges"
      },
      {
        "command": "claudeInlineDiff.prevHunkInFile",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus && claudeInlineDiff.activeFileHasChanges"
      },
      {
        "command": "claudeInlineDiff.nextFile",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "editorTextFocus && claudeInlineDiff.hasChanges"
      },
      {
        "command": "claudeInlineDiff.prevFile",
        "key": "alt+h",
        "mac": "alt+h",
        "when": "editorTextFocus && claudeInlineDiff.hasChanges"
      },
      {
        "command": "claudeInlineDiff.nextFile",
        "key": "ctrl+alt+pagedown",
        "mac": "cmd+alt+pagedown",
        "when": "claudeInlineDiff.hasChanges"
      },
      {
        "command": "claudeInlineDiff.prevFile",
        "key": "ctrl+alt+pageup",
        "mac": "cmd+alt+pageup",
        "when": "claudeInlineDiff.hasChanges"
      },
      {
        "command": "claudeInlineDiff.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && claudeInlineDiff.canUndoAccept"
      }
    ],
    "configuration": {
      "title": "Claude Inline Diff",
      "properties": {
        "claudeInlineDiff.storage.location": {
          "type": "string",
          "default": "project",
          "markdownDescription": "Where review snapshots live. `project`: `<git root>/.claude-review/` (ignores itself via its own `.gitignore`). `home`: `~/.claude/inline-diff/store/`. Files outside the project always use `home`.",
          "enum": [
            "project",
            "home"
          ]
        },
        "claudeInlineDiff.storage.projectDirName": {
          "type": "string",
          "default": ".claude-review",
          "markdownDescription": "Folder name of the project-local store."
        },
        "claudeInlineDiff.trackBashEdits": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Detect files changed by Claude's **Bash** tool (git repositories only: compares `git status` before/after each command)."
        },
        "claudeInlineDiff.keybindingScheme": {
          "type": "string",
          "default": "both",
          "markdownDescription": "`cursor`: Cmd/Ctrl+Y / N per change, Cmd/Ctrl+Shift+Y / N per file. `alt`: Cmd/Ctrl+Alt+Enter / Backspace (+Shift for file). `both`: all of them. Keys are only active while the cursor is inside a Claude change (file keys: while the file has changes).",
          "enum": [
            "cursor",
            "alt",
            "both"
          ]
        },
        "claudeInlineDiff.autoAdvance": {
          "type": "string",
          "default": "cursor",
          "markdownDescription": "Where the cursor goes after Keep / Undo. `cursor` (like Cursor): Keep of a change moves to the next change in the same file; Undo, Keep File and Undo File stay put. `hunkThenFile`: every action moves to the next change, then the next file. `hunk`: every action moves to the next change in the file. `off`: never move.",
          "enum": [
            "cursor",
            "hunkThenFile",
            "hunk",
            "off"
          ]
        },
        "claudeInlineDiff.followClaude": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When Claude lands a new change in a visible file, scroll to it and briefly highlight it. Off by default, like Cursor. Never moves the view while your cursor is inside a change."
        },
        "claudeInlineDiff.revealOnEdit": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Open a file (preview tab, focus stays where it is) when Claude starts changing it, scrolled to the change. Off by default, like Cursor."
        },
        "claudeInlineDiff.deletedLines.renderer": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "`auto`: red inline blocks via the `editorInsets` proposed API when enabled, otherwise decorations. `inset` / `decoration` force one.",
          "enum": [
            "auto",
            "inset",
            "decoration"
          ]
        },
        "claudeInlineDiff.deletedLines.maxLines": {
          "type": "number",
          "default": 30,
          "markdownDescription": "Removed lines drawn per block before collapsing the rest.",
          "minimum": 3,
          "maximum": 500
        },
        "claudeInlineDiff.hunkToolbar": {
          "type": "string",
          "default": "cursor",
          "markdownDescription": "Pill under a change: `⌃ 1 of 3 ⌄ | Undo | Keep` (needs the editorInsets API). `cursor` (like Cursor): one pill, under the change nearest to where you last were, with the text cursor or the mouse; lines below it shift by one row when it moves, because extensions cannot overlay the editor. `all`: under every change. `active`: under the change at the text cursor only. `off`: use CodeLens instead.",
          "enum": [
            "cursor",
            "all",
            "active",
            "off"
          ]
        },
        "claudeInlineDiff.showCodeLens": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also show Keep / Undo CodeLens above changes and at the top of the file (always used when the editorInsets API is unavailable or `hunkToolbar` is `off`)."
        },
        "claudeInlineDiff.floatingBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Floating **Undo File / Keep File** buttons at the bottom-right of the editor, like Cursor's per-file bar (Cursor shows two buttons there); Undo All / Keep All are in the Claude Changes list (needs the `contribEditorContentMenu` proposed API, enabled by the same argv.json line)."
        },
        "claudeInlineDiff.highlightWords": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Mark changed words inside removed lines. Off by default: Cursor shows removed lines in one colour."
        },
        "claudeInlineDiff.saveAfterReject": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Save the file after Reject so Claude reads what you see."
        },
        "claudeInlineDiff.absorbUserEdits": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Your own edits outside Claude's changes are folded into the baseline (never shown as Claude's). Edits inside a change become part of it."
        },
        "claudeInlineDiff.confirmRejectAll": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before rejecting all changes in all files."
        },
        "claudeInlineDiff.confirmDeleteCreatedFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before moving a file Claude created to the trash on Reject."
        },
        "claudeInlineDiff.stepRetentionDays": {
          "type": "number",
          "default": 7,
          "markdownDescription": "Keep per-step snapshots (for step revert) this many days.",
          "minimum": 1
        },
        "claudeInlineDiff.pollIntervalMs": {
          "type": "number",
          "default": 700,
          "markdownDescription": "How often to look for new snapshots (ms). File watchers are used too. Applies after reloading the window.",
          "minimum": 200
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "claudeInlineDiff.undoFileText",
          "group": "navigation@1",
          "when": "resourceScheme == file && claudeInlineDiff.activeFileHasChanges"
        },
        {
          "command": "claudeInlineDiff.keepFileText",
          "group": "navigation@2",
          "when": "resourceScheme == file && claudeInlineDiff.activeFileHasChanges"
        },
        {
          "command": "claudeInlineDiff.prevHunk",
          "group": "1_claudeInlineDiff@1",
          "when": "resourceScheme == file && claudeInlineDiff.activeFileHasChanges"
        },
        {
          "command": "claudeInlineDiff.nextHunk",
          "group": "1_claudeInlineDiff@2",
          "when": "resourceScheme == file && claudeInlineDiff.activeFileHasChanges"
        },
        {
          "command": "claudeInlineDiff.showDiff",
          "group": "1_claudeInlineDiff@3",
          "when": "resourceScheme == file && claudeInlineDiff.activeFileHasChanges"
        },
        {
          "command": "claudeInlineDiff.reviewAll",
          "group": "1_claudeInlineDiff@4",
          "when": "resourceScheme == file && claudeInlineDiff.activeFileHasChanges"
        }
      ],
      "editor/content": [
        {
          "command": "claudeInlineDiff.undoFileText",
          "group": "claudeInlineDiff@1",
          "when": "resourceScheme == file && config.claudeInlineDiff.floatingBar && resourcePath in claudeInlineDiff.activeFiles"
        },
        {
          "command": "claudeInlineDiff.keepFileTextMac",
          "group": "claudeInlineDiff@2",
          "when": "resourceScheme == file && config.claudeInlineDiff.floatingBar && resourcePath in claudeInlineDiff.activeFiles && isMac && config.claudeInlineDiff.keybindingScheme != 'alt'"
        },
        {
          "command": "claudeInlineDiff.keepFileTextCtrl",
          "group": "claudeInlineDiff@2",
          "when": "resourceScheme == file && config.claudeInlineDiff.floatingBar && resourcePath in claudeInlineDiff.activeFiles && !isMac && config.claudeInlineDiff.keybindingScheme != 'alt'"
        },
        {
          "command": "claudeInlineDiff.keepFileText",
          "group": "claudeInlineDiff@2",
          "when": "resourceScheme == file && config.claudeInlineDiff.floatingBar && resourcePath in claudeInlineDiff.activeFiles && config.claudeInlineDiff.keybindingScheme == 'alt'"
        },
        {
          "command": "claudeInlineDiff.keepAllChangesText",
          "group": "claudeInlineDiff@5",
          "when": "resourceScheme == file && config.claudeInlineDiff.floatingBar && resourcePath not in claudeInlineDiff.files && claudeInlineDiff.hasChanges && !inlineDiffs.activeEditorWithDiffs"
        },
        {
          "command": "claudeInlineDiff.nextFileText",
          "group": "claudeInlineDiff@6",
          "when": "resourceScheme == file && config.claudeInlineDiff.floatingBar && resourcePath not in claudeInlineDiff.files && claudeInlineDiff.hasChanges && !inlineDiffs.activeEditorWithDiffs"
        }
      ],
      "editor/context": [
        {
          "command": "claudeInlineDiff.acceptHunk",
          "group": "0_claudeInlineDiff@1",
          "when": "claudeInlineDiff.cursorInHunk"
        },
        {
          "command": "claudeInlineDiff.rejectHunk",
          "group": "0_claudeInlineDiff@2",
          "when": "claudeInlineDiff.cursorInHunk"
        },
        {
          "command": "claudeInlineDiff.rejectHunkWithFeedback",
          "group": "0_claudeInlineDiff@3",
          "when": "claudeInlineDiff.cursorInHunk"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeInlineDiff.acceptFile",
          "group": "7_claudeInlineDiff@1",
          "when": "resourcePath in claudeInlineDiff.files"
        },
        {
          "command": "claudeInlineDiff.rejectFile",
          "group": "7_claudeInlineDiff@2",
          "when": "resourcePath in claudeInlineDiff.files"
        },
        {
          "command": "claudeInlineDiff.showDiff",
          "group": "7_claudeInlineDiff@3",
          "when": "resourcePath in claudeInlineDiff.files"
        }
      ],
      "view/title": [
        {
          "command": "claudeInlineDiff.undo",
          "group": "0_history@1",
          "when": "view == claudeInlineDiff.changes"
        },
        {
          "command": "claudeInlineDiff.refresh",
          "group": "1_more@1",
          "when": "view == claudeInlineDiff.changes || view == claudeInlineDiff.steps"
        },
        {
          "command": "claudeInlineDiff.installHooks",
          "group": "1_more@2",
          "when": "view == claudeInlineDiff.changes"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeInlineDiff.revertStep",
          "group": "inline@1",
          "when": "view == claudeInlineDiff.steps && viewItem == step"
        },
        {
          "command": "claudeInlineDiff.revertStep",
          "group": "0_step@1",
          "when": "view == claudeInlineDiff.steps && viewItem == step"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeInlineDiff.openFile",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.revertStep",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.refresh",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.keepFileText",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.keepFileTextMac",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.keepFileTextCtrl",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.undoFileText",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.nextFileText",
          "when": "false"
        },
        {
          "command": "claudeInlineDiff.keepAllChangesText",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
